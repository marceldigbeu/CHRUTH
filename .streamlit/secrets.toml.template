# Modele de secrets CHRUTH — copier en `.streamlit/secrets.toml` et remplir.
#
# Ce fichier NE DOIT JAMAIS etre commite ni envoye : il ouvre l'acces a l'app.
# Sans lui, la connexion passe par les comptes locaux (aucun bouton Google).
#
# Marche a suivre complete : docs/GUIDE_CONNEXION.md

# --- Qui a le droit d'entrer ------------------------------------------------
# C'est ici, et nulle part ailleurs, que l'administrateur ouvre et ferme l'acces.
[acces]
# Adresses autorisees. Liste VIDE = tout compte authentifie entre.
emails = [
    # "collaboratrice@exemple.fr",
]
# Adresses administratrices, affichees a qui se voit refuser l'acces.
# Vide : sur poste sans [auth], tout compte local connecte administre.
admins = [
    # "ton.adresse@exemple.fr",
]
# Utilisateur de repli hors session (pages ouvertes seules, tests).
# Pour le generer : python -c "import secrets; print(secrets.token_hex(16))"
# utilisateur_local = "local@chruth"

# --- Espace membres (donnees personnelles) ----------------------------------
# Cle de chiffrement Fernet des fichiers membres (branche espace-membres).
# Ne JAMAIS publier cette cle : sans elle, les donnees personnelles sont illisibles.
# Pour en generer une : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
[espace]
cle_chiffrement = ""

# --- Fournisseur d'identite -------------------------------------------------
# Commenter TOUTE cette section retire le bouton Google ; la connexion reste
# exige via les comptes locaux.
[auth]
# Adresse de retour apres connexion. En local, garder ce port.
redirect_uri = "http://localhost:8501/oauth2callback"
# Chaine aleatoire et secrete, propre a cette installation. Pour en generer une :
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = ""

[auth.google]
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
