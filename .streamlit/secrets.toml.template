# Modele de secrets CHRUTH — copier en `.streamlit/secrets.toml` et remplir.
#
# Ce fichier NE DOIT JAMAIS etre commite ni envoye : il ouvre l'acces a l'app.
# Sans lui, la plateforme demarre sans page de connexion (mode poste local).
#
# Marche a suivre complete : docs/GUIDE_CONNEXION.md

# --- Qui a le droit d'entrer ------------------------------------------------
# C'est ici, et nulle part ailleurs, que l'administrateur ouvre et ferme l'acces.
[acces]
# Adresses autorisees. Liste VIDE = tout compte authentifie entre.
emails = [
    # "collaboratrice@exemple.fr",
]
# Adresses administratrices, affichees a qui se voit refuser l'acces.
admins = [
    # "ton.adresse@exemple.fr",
]

# --- Fournisseur d'identite -------------------------------------------------
# Supprimer ou commenter TOUTE cette section desactive la page de connexion.
[auth]
# Adresse de retour apres connexion. En local, garder ce port.
redirect_uri = "http://localhost:8501/oauth2callback"
# Chaine aleatoire et secrete, propre a cette installation. Pour en generer une :
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = ""

[auth.google]
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
