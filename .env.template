# Moteur IA CHRUTH — copier ce fichier en ".env" et coller UNE cle pour activer l'IA.
# Lu automatiquement par l'app de messages ET les notebooks (via python-dotenv).
#
# Le moteur se regle TOUT SEUL (aucun reglage obligatoire) :
#   1) une cle cloud ci-dessous  -> IA cloud (rapide, non bridee) ;
#   2) sinon Ollama local s'il tourne ;
#   3) sinon brouillon deterministe.
#
# Colle UNE SEULE cle cloud (si plusieurs, ordre de priorite : anthropic > mistral > groq > gemini) :
# ANTHROPIC_API_KEY=sk-ant-...
# MISTRAL_API_KEY=...
# GROQ_API_KEY=...
# GEMINI_API_KEY=AIza...   (gratuite sur https://aistudio.google.com/apikey)

# --- Optionnel ---
# Forcer un fournisseur precis (sinon detection auto) : anthropic | mistral | groq | gemini | ollama
# CHRUTH_LLM_PROVIDER=
# Modele (laisser vide = defaut du fournisseur) :
# CHRUTH_LLM_MODEL=llama3.1:8b
# Hote Ollama local :
# OLLAMA_HOST=http://localhost:11434
